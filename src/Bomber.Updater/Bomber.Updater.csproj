<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization Condition="'$(RuntimeIdentifier)' == 'linux-x64'">true</InvariantGlobalization>
    <AssemblyName>BlastUpdater</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Bomber.Client/Updates/DesktopProcessIdentity.cs" Link="DesktopProcessIdentity.cs" />
    <Compile Include="../Bomber.Client/Updates/DesktopUpdateRequest.cs" Link="DesktopUpdateRequest.cs" />
    <Compile Include="../Bomber.Client/Updates/DesktopUpdateTransaction.cs" Link="DesktopUpdateTransaction.cs" />
  </ItemGroup>
</Project>
