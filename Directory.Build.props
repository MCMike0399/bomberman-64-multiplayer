<Project>
  <Import Project="$(MSBuildThisFileDirectory)Release.props" />
  <!-- Defaults shared by every product, test and probe project here. The ignored
       burbuja-kernel checkout has its own Directory.Build.props, so MSBuild stops
       there and kernel projects are unaffected. Projects keep only what differs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(BlastVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BlastVersion" Value="$(BlastVersion)" />
    <AssemblyMetadata Include="BlastBuild" Value="$(BlastBuild)" />
    <AssemblyMetadata Include="BlastProtocolRevision" Value="$(BlastProtocolRevision)" />
  </ItemGroup>
</Project>
